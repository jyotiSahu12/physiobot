# --- LLM provider ----------------------------------------------------------
# "ollama" for local dev (free, private). "groq" for cloud deploy.
LLM_PROVIDER=ollama
# Only needed when LLM_PROVIDER=groq. Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# --- Google service account -------------------------------------------------
# Local: absolute path to the JSON key file. NEVER commit the file.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# Cloud (Render/Railway/Fly): leave the path empty and paste the FULL JSON here
# (the deploy host has no file on disk). Use one or the other, not both.
GOOGLE_CREDENTIALS_JSON=

# --- Meta WhatsApp Cloud API ------------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=physiobot-verify
WHATSAPP_APP_SECRET=
